<h1>{{title}}</h1>
{{#if isAuthenticated }}
<p>Hi {{username}}!</p>
<a href="/call-graph-direct">Acquire a token to call Microsoft Graph</a>
<br>
<a href="/call-graph-on-behalf">Acquire a token to call a web API that calls Microsoft Graph on your behalf</a>
<br>
<form action="/remove-account" method="POST" style="display:inline;">
  <button type="submit" style="background:none;border:none;color:blue;text-decoration:underline;cursor:pointer;">Remove Account</button>
</form>
{{else}}
<p>Welcome to {{title}}</p>
{{/if}}